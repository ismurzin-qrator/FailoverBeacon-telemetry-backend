{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["beacon_url", "projects"],
  "properties": {
    "beacon_url": {
      "description": "Public base URL of this installation; beacon URLs are <beacon_url>/v1/beacon/<key>.",
      "type": "string",
      "pattern": "^https://[^/]+$"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "packages", "keys"],
        "properties": {
          "id": {
            "description": "Stable project ID, stored with every event.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "packages": {
            "description": "App packages allowed to send with the project's keys, or \"*\" for any.",
            "oneOf": [
              { "const": "*" },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
                }
              }
            ]
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "enabled", "added"],
              "properties": {
                "key": {
                  "description": "128 random bits in lowercase base32.",
                  "type": "string",
                  "pattern": "^[a-z2-7]{26}$"
                },
                "enabled": { "type": "boolean" },
                "added": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
